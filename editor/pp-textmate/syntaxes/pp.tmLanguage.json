{
  "name": "PiPo",
  "scopeName": "source.pp",
  "fileTypes": ["pp"],
  "patterns": [
    { "name": "comment.line.double-slash.pp", "match": "//.*$" },
    { "name": "comment.block.pp", "begin": "/\\*", "end": "\\*/" },
    {
      "name": "string.quoted.double.pp",
      "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.pp", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)" }]
    },
    {
      "name": "string.quoted.single.pp",
      "begin": "'", "end": "'",
      "patterns": [{ "name": "constant.character.escape.pp", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)" }]
    },
    { "name": "constant.numeric.pp", "match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\\b" },
    {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&|^~#?@$\\\\.]+)",
      "captures": {
        "1": { "name": "keyword.other.pp" },
        "2": { "name": "entity.name.function.pp" }
      }
    },
    { "name": "constant.language.pp", "match": "\\b(true|false)\\b" },
    { "name": "keyword.control.pp", "match": "\\b(if|else|for|in|while|break|continue|return|match)\\b" },
    { "name": "keyword.other.pp", "match": "\\b(import|export|global|native|function|const|let|enum|type|interface|impl|precedence|over|under|as)\\b" },
    { "name": "storage.type.pp", "match": "\\b(int|float|string|bool|void|any|range|object|number|tuple)\\b" },
    { "name": "entity.name.type.pp", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "entity.name.function.call.pp", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()" },
    { "name": "entity.name.namespace.pp", "match": "\\b[a-z_][A-Za-z0-9_]*(?=:[A-Za-z_])" },
    { "name": "punctuation.accessor.pp", "match": ":(?=[A-Za-z_])|\\.(?=[A-Za-z_])" },
    { "name": "keyword.operator.pp", "match": "->|[-+*/%<>=!&|^~#?@$\\\\]+|\\.\\.\\.=?" }
  ]
}
