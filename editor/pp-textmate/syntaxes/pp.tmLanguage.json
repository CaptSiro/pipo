{
  "name": "PiPo",
  "scopeName": "source.pp",
  "fileTypes": ["pp"],
  "patterns": [
    { "name": "comment.line.double-slash.pp", "match": "//.*$" },
    { "name": "comment.block.pp", "begin": "/\\*", "end": "\\*/" },
    {
      "name": "string.quoted.double.pp",
      "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.pp", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)" }]
    },
    {
      "name": "string.quoted.single.pp",
      "begin": "'", "end": "'",
      "patterns": [{ "name": "constant.character.escape.pp", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)" }]
    },
    {"match": "(</)([A-Za-z_][A-Za-z0-9_]*(?::[A-Za-z_][A-Za-z0-9_]*)*)\\s*(>)", "captures": {"1": {"name": "punctuation.definition.tag.begin.pp"}, "2": {"name": "entity.name.tag.pp"}, "3": {"name": "punctuation.definition.tag.end.pp"}}},
    {"name": "meta.tag.pp", "begin": "(?:(?<=\\breturn )|(?<=\\byield )|(?<=\\bemit )|(?<=\\belse )|(?<![A-Za-z0-9_)\\]}\"'] )(?<![A-Za-z0-9_)\\]}\"']))(<)([A-Za-z_][A-Za-z0-9_]*(?::[A-Za-z_][A-Za-z0-9_]*)*)(?!>\\s*(?:function|generator|type|interface|impl|scope|enum)\\b)(?=\\s*(?:/?>|[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*\\s*(?:=|/?>|\\s)))", "beginCaptures": {"1": {"name": "punctuation.definition.tag.begin.pp"}, "2": {"name": "entity.name.tag.pp"}}, "end": "(/?>)", "endCaptures": {"1": {"name": "punctuation.definition.tag.end.pp"}}, "patterns": [{"name": "entity.other.attribute-name.pp", "match": "[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*"}, {"name": "keyword.operator.assignment.pp", "match": "="}, {"name": "string.quoted.double.pp", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.pp", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)"}]}, {"name": "constant.numeric.pp", "match": "-?[0-9][0-9_]*(\\.[0-9][0-9_]*)?"}, {"name": "meta.embedded.expression.pp", "begin": "\\{", "end": "\\}", "beginCaptures": {"0": {"name": "punctuation.section.embedded.begin.pp"}}, "endCaptures": {"0": {"name": "punctuation.section.embedded.end.pp"}}, "patterns": [{"include": "$self"}]}]},
    { "name": "constant.numeric.pp", "match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\\b" },
    {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&|^~#?@$\\\\.]+)",
      "captures": {
        "1": { "name": "keyword.other.pp" },
        "2": { "name": "entity.name.function.pp" }
      }
    },
    {
      "match": "\\b(generator)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.other.pp" },
        "2": { "name": "entity.name.function.pp" }
      }
    },
    {
      "match": "\\b(scope)\\s+(_[A-Za-z0-9_]+)",
      "captures": {
        "1": { "name": "keyword.other.pp" },
        "2": { "name": "entity.name.function.pp" }
      }
    },
    { "name": "entity.name.function.call.pp", "match": "\\b_[A-Za-z0-9_]+\\b" },
    { "name": "variable.language.pp", "match": "\\bscope\\b" },
    { "name": "constant.language.pp", "match": "\\b(true|false)\\b" },
    { "name": "keyword.control.pp", "match": "\\b(if|else|for|in|while|break|continue|return|yield|emit|match|defer|as)\\b" },
    { "name": "keyword.other.pp", "match": "\\b(import|export|global|native|extern|function|const|let|enum|type|interface|impl|precedence|over|under|as)\\b" },
    { "name": "storage.type.pp", "match": "\\b(int|float|string|bool|void|any|unknown|Range|object|number|tuple|Block|Callback|Generator|Map|Set)\\b" },
    { "name": "entity.name.type.pp", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "entity.name.function.call.pp", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()" },
    { "name": "entity.name.namespace.pp", "match": "\\b[a-z_][A-Za-z0-9_]*(?=:[A-Za-z_])" },
    { "name": "punctuation.accessor.pp", "match": ":(?=[A-Za-z_])|\\.(?=[A-Za-z_])" },
    { "name": "keyword.operator.pp", "match": "->|[-+*/%<>=!&|^~#?@$\\\\]+|\\.\\.\\.=?" }
  ]
}
